KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=$HOME/.config/kalshi/private-key.pem
KALSHI_BINANCE_WS_URL=wss://stream.binance.us:9443/ws/btcusdt@bookTicker
KALSHI_DATA_DIR=data/kalshi
KALSHI_SUBACCOUNT=0

KALSHI_ORDER_COUNT=5
KALSHI_MAX_ABS_POSITION=50
KALSHI_MAX_OPEN_COUNT=20
KALSHI_MAX_QUOTE_NOTIONAL_DOLLARS=10
KALSHI_CASH_RESERVE_DOLLARS=10
KALSHI_MIN_ORDER_COUNT=1
KALSHI_MIN_EDGE_DOLLARS=0.01
KALSHI_INVENTORY_SKEW_DOLLARS=0.02
KALSHI_STALE_AFTER_MS=2000
KALSHI_CLOSE_CUTOFF_S=90
KALSHI_MAKER_FEE_MULTIPLIER=0
KALSHI_ALLOW_PROXY_PRICING=0
KALSHI_WS_INSECURE=0
