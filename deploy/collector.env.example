KALSHI_API_KEY_ID=replace-me
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/.config/kalshi/private-key.pem
KALSHI_BINANCE_WS_URL=wss://stream.binance.us:9443/ws/btcusdt@bookTicker
KALSHI_EXTERNAL_DEPTH_ENABLED=1
KALSHI_EXTERNAL_DEPTH_LEVELS=10
KALSHI_EXTERNAL_DEPTH_SAMPLE_HZ=10
KALSHI_BINANCE_DEPTH_WS_URL=wss://stream.binance.us:9443/ws/btcusdt@depth20@100ms
KALSHI_DATA_DIR=/home/ubuntu/kalshi_btc_mm/data/kalshi
AWS_REGION=us-east-1
KALSHI_S3_BUCKET=replace-with-private-bucket
KALSHI_S3_PREFIX=kalshi-btc15m
KALSHI_LOCAL_RETENTION_DAYS=7
KALSHI_ARCHIVE_STABLE_AGE_S=60
KALSHI_SETTLEMENT_GRACE_S=900
KALSHI_RESERVE_FREE_GB=10
KALSHI_TARGET_FREE_GB=15
