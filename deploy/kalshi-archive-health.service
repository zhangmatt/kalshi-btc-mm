[Unit]
Description=Validate Kalshi S3 archival and local disk reserve
Wants=network-online.target
After=network-online.target kalshi-archive.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kalshi_btc_mm
EnvironmentFile=/home/ubuntu/.config/kalshi/collector.env
EnvironmentFile=-/home/ubuntu/.config/kalshi/archive.env
ExecStart=/home/ubuntu/kalshi_btc_mm/.venv/bin/python -m kalshi_mm.archive --health
TimeoutStartSec=2min
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi_btc_mm/data
InaccessiblePaths=-/home/ubuntu/.config/kalshi/private-key.pem
