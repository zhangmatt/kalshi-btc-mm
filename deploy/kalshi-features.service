[Unit]
Description=Compact finalized Kalshi recordings into the feature store
Wants=network-online.target
After=kalshi-collector.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kalshi_btc_mm
EnvironmentFile=/home/ubuntu/.config/kalshi/collector.env
ExecStart=/bin/bash -c 'exec 9>/home/ubuntu/kalshi_btc_mm/data/.research.lock; flock -w 60 9 || exit 0; shopt -s nullglob; exec /home/ubuntu/kalshi_btc_mm/.venv/bin/kalshi-mm-features /home/ubuntu/kalshi_btc_mm/data/kalshi/*/events_*.jsonl.gz --out /home/ubuntu/kalshi_btc_mm/data/features'
TimeoutStartSec=15min
UMask=0077
Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=1792M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi_btc_mm/data
InaccessiblePaths=-/home/ubuntu/.config/kalshi/private-key.pem
