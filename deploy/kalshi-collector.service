[Unit]
Description=Kalshi BTC 15-minute market data collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kalshi_btc_mm
EnvironmentFile=/home/ubuntu/.config/kalshi/collector.env
ExecStart=/home/ubuntu/kalshi_btc_mm/.venv/bin/python -m kalshi_mm.collect --windows 0
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
