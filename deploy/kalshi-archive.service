[Unit]
Description=Archive finalized Kalshi recordings to S3
Wants=network-online.target
After=network-online.target kalshi-collector.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kalshi_btc_mm
EnvironmentFile=/home/ubuntu/.config/kalshi/collector.env
EnvironmentFile=-/home/ubuntu/.config/kalshi/archive.env
ExecStart=/bin/bash -c 'exec 9>/home/ubuntu/kalshi_btc_mm/data/.research.lock; flock -w 60 9 || exit 0; exec /home/ubuntu/kalshi_btc_mm/.venv/bin/python -m kalshi_mm.archive'
TimeoutStartSec=10min
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi_btc_mm/data
InaccessiblePaths=-/home/ubuntu/.config/kalshi/private-key.pem
